<?xml version="1.0" encoding="utf-8"?>
<!-- Messages live in the system SMS store (backed up by the OS) and in Yarn's encrypted
     database, whose key never leaves this device. Nothing of Yarn's is uploaded by Auto Backup;
     use Settings > Backup for encrypted, user-controlled backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
