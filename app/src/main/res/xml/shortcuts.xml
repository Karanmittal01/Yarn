<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_message"
        android:enabled="true"
        android:icon="@drawable/ic_compose"
        android:shortcutShortLabel="@string/shortcut_new_message">
        <intent
            android:action="android.intent.action.SENDTO"
            android:data="smsto:"
            android:targetPackage="app.yarn.messages"
            android:targetClass="app.yarn.MainActivity" />
    </shortcut>
    <!-- Named after the app, so launchers that search shortcuts find Yarn by its name. -->
    <shortcut
        android:shortcutId="open_yarn"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_yarn"
        android:shortcutLongLabel="@string/shortcut_yarn_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.yarn.messages"
            android:targetClass="app.yarn.MainActivity" />
    </shortcut>
</shortcuts>
